h3.modal-header.m-0.pb-0 {{ title }}

.modal-body
    .alert.alert-danger(*ngIf='error') {{ error }}

    .mb-2(*ngIf='mode === "setup"')
        | This password encrypts your connection configs.
        | It cannot be recovered if lost — encrypted remote data becomes unrecoverable.

    .mb-2(*ngIf='mode === "change"')
        | Enter your current password, then choose a new one.

    .mb-2(*ngIf='mode === "unlock"')
        | Enter your sync password to unlock cloud sync for this session.

    .input-group.mb-2(*ngIf='mode === "change"')
        input.form-control(
            [type]='showPassword ? "text" : "password"',
            [(ngModel)]='oldPassword',
            #firstInput,
            placeholder='Current password',
            (keyup.enter)='ok()',
        )

    .input-group.mb-2(*ngIf='mode !== "change"')
        input.form-control(
            [type]='showPassword ? "text" : "password"',
            [(ngModel)]='password',
            #firstInput,
            placeholder='Sync password',
            (keyup.enter)='ok()',
        )

    .input-group.mb-2(*ngIf='mode !== "unlock"')
        input.form-control(
            [type]='showPassword ? "text" : "password"',
            [(ngModel)]='confirmPassword',
            placeholder='Confirm password',
            (keyup.enter)='ok()',
        )

    .form-check
        input.form-check-input(
            type='checkbox',
            [(ngModel)]='showPassword',
            id='showPassword',
        )
        label.form-check-label(for='showPassword') Show password

.modal-footer
    button.btn.btn-primary((click)='ok()') {{ okLabel }}
    button.btn.btn-danger((click)='cancel()') Cancel
